# Source-only root allowlist. Review new stack components before adding them.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/LICENSE
!/SECURITY.md
!/UPSTREAM_SOURCES.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/cordis.patch.yml
!/config.profile.example.yml
!/src/
!/scripts/
!/third-party/

# Keep tooling and legal inputs explicit.
/scripts/*
!/scripts/build.mjs
!/scripts/bundle.mjs
!/scripts/check-boundaries.mjs
!/scripts/boundary-exceptions.json
!/scripts/package.mjs
!/scripts/release-files.mjs
!/scripts/verify-package.mjs
!/scripts/measure-production.mjs
!/scripts/package-upstream.mjs
/third-party/*
!/third-party/UPSTREAM_SOURCES.md
!/third-party/UPSTREAM_NOTICES.txt
!/third-party/upstream-sources.json

# Defense in depth for private/generated files within allowed trees.
.local/
.baseseer/
.claude/
.impeccable/
.ssh/
.vscode/
.idea/
node_modules/
dist/
output/
coverage/
test-results/
playwright-report/
.env
.env.*
.npmrc
.netrc
config.local.*
credentials.json
auth.json
*.dpapi
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.log
*.db
*.sqlite*
*.tgz
*.tar.gz
*.zip
*.bak
*.tmp
.DS_Store
Thumbs.db
