{
  "name": "dsh-baseseer",
  "version": "0.0.0-development",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "BaseSeer: talk through your app idea, see the plan, and let models build it.",
  "type": "module",
  "main": "./dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "measure:production": "node scripts/measure-production.mjs",
    "package:private": "node scripts/package.mjs",
    "package:verify": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@fontsource/barlow": "^5.3.0",
    "@types/css-tree": "3.2.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.26",
    "esbuild": "0.25.12",
    "playwright": "1.62.1",
    "react": "18.3.1"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "css-tree": "3.2.1",
    "elkjs": "0.12.0",
    "marked": "18.1.0",
    "parse5": "8.0.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  }
}
